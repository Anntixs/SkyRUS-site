@page "/permits"
@model PermitsModel
@{ ViewData["Title"] = "Допуски"; }
<div class="wrap page">
  <h1>Допуски</h1>
  <div class="chips">
    <a class="chip @(Model.Selected == null ? "on" : "")" href="/permits">Все</a>
    @foreach (var f in Model.Firs) { <a class="chip @(Model.Selected?.Id == f.Id ? "on" : "")" href="/permits?fir=@f.Code">@f.Name</a> }
  </div>
  @if (Model.List.Count == 0) { <div class="empty">Действующих допусков нет.</div> }
  else
  {
    <div class="table-wrap"><table>
      <thead><tr><th>Диспетчер</th><th>Допуски</th></tr></thead>
      <tbody>
      @foreach (var (name, positions) in Model.List)
      {
        <tr><td>@name</td><td>@foreach (var p in positions) { <span class="badge mono permit">@p</span> }</td></tr>
      }
      </tbody>
    </table></div>
  }
</div>
