@page "/admin/staff"
@model SkyRus.Site.Pages.Admin.StaffModel
@{ ViewData["Title"] = "Сотрудники"; }
<h1>Сотрудники учебного центра</h1>
<p class="muted" style="max-width:760px"><b>Менторы</b> берут заявки, ведут студентов, проводят зачёты по теории и практике. <b>Инструкторы</b> вдобавок проводят экзамены на рейтинг и выдают допуски. <b>Администраторы</b> управляют сотрудниками, видами аттестаций, регионами, новостями и документами. Администраторы из настроек сервера (<span class="mono">Site:Admins</span>) не снимаются здесь.</p>
@if (Model.Message != null) { <div class="alert ok">@Model.Message</div> }
@if (Model.Error != null) { <div class="alert error">@Model.Error</div> }
<div class="table-wrap" style="margin-bottom:22px"><table>
  <thead><tr><th>CID</th><th>Имя</th><th>Рейтинг</th><th>Роль</th><th></th></tr></thead>
  <tbody>
  @foreach (var s in Model.List)
  {
    <tr><td class="mono">@s.Cid</td><td>@s.Name</td><td><span class="rating">@s.Rating</span></td><td>@UserService.Roles[s.Role]</td>
      <td>@if (s.AddedAt > 0 && s.Cid != Model.Me.Cid) { <form method="post" asp-page-handler="Remove"><input type="hidden" name="cid" value="@s.Cid"><button class="btn btn-sm btn-danger" type="submit">Снять</button></form> }</td></tr>
  }
  </tbody>
</table></div>
<form method="post" class="card row">
  <label style="max-width:200px"><span>CID</span><input name="cid" inputmode="numeric" required></label>
  <label style="max-width:240px"><span>Роль</span>
    <select name="role">@foreach (var (k, v) in UserService.Roles) { <option value="@k" selected="@(k == "mentor")">@v</option> }</select></label>
  <button class="btn btn-primary" type="submit">Добавить или изменить</button>
</form>
