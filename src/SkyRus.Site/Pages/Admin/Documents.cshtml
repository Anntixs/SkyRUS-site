@page "/admin/documents"
@model SkyRus.Site.Pages.Admin.DocumentsModel
@{ ViewData["Title"] = "Документы"; }
<div class="head"><h1>Документы</h1><a class="btn btn-primary" href="/admin/documents/new">Добавить</a></div>
@if (Model.List.Count == 0) { <div class="empty">Документов пока нет.</div> }
<div class="table-wrap"><table>
  <thead><tr><th>Название</th><th>Раздел</th><th>Обновлён</th></tr></thead>
  <tbody>@foreach (var d in Model.List) { <tr><td><a href="/admin/documents/@d.Id">@d.Title</a></td><td>@d.Category</td><td>@Format.Short(d.Updated)</td></tr> }</tbody>
</table></div>
